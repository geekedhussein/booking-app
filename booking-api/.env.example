# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Part VIII: config lives in the environment, separated from code (12-Factor).

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# MongoDB connection string. The path is the database name (booking).
# MongoDB must run as a replica set (even one node) because bookings use
# multi-document transactions. directConnection=true talks to this one node
# directly, which works from the host and from inside Docker alike.
# Start one with:  docker compose up -d mongo
MONGODB_URI=mongodb://localhost:27017/booking?directConnection=true

# How long (ms) graceful shutdown waits for in-flight requests before force-exit.
SHUTDOWN_TIMEOUT_MS=10000

# --- Auth ---
# Generate a strong random secret for production, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# --- Redis (cache + job queue) ---
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# --- V2.1 Hardening ---
# Comma-separated browser origins allowed via CORS (no spaces needed). Never "*".
CORS_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
BOOKING_MAX_ADVANCE_DAYS=365

# --- V2.4 Auth hardening ---
REFRESH_TOKEN_EXPIRES_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_MINUTES=15

# --- V2.5 Account flows ---
# Where links in emails point: the frontend (5173 in dev, 8080 with docker compose).
APP_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=60

# --- V2.9 Scheduler ---
SCHEDULER_INTERVAL_MS=60000
REMINDER_LEAD_HOURS=24
REMINDER_BATCH_SIZE=100
RETENTION_DAYS=7

# --- V2.3 Outbox relay ---
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
