{
  "name": "booking-api",
  "version": "1.0.0",
  "description": "A booking/reservation API built from first principles \u2014 teaching project.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "start:prod": "node src/server.js",
    "worker:prod": "node src/worker.js",
    "migrate:prod": "node src/db/migrate.js",
    "worker": "node --env-file=.env src/worker.js",
    "relay": "node --env-file=.env src/outbox-relay.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "test": "node --test --experimental-test-module-mocks \"tests/unit/*.test.js\"",
    "test:unit": "node --test --experimental-test-module-mocks \"tests/unit/*.test.js\"",
    "test:integration": "node --env-file=.env.test --test \"tests/integration/*.test.js\"",
    "test:e2e": "node --env-file=.env.test --test \"tests/e2e/*.test.js\"",
    "scheduler": "node --env-file=.env src/scheduler.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "loadtest": "node --env-file=.env scripts/load-test.js",
    "seed": "node --env-file=.env scripts/seed-demo.js",
    "demo:race": "node --env-file=.env scripts/demo-naive-race.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.2.2"
  }
}
