# Leave unset in development: Vite proxies /v1, /ws and /docs to the backend.
# Set it only when the frontend is served from a different origin than the API
# (and add that origin to the backend's CORS_ORIGINS).
# VITE_API_URL=https://api.example.com

# Where the dev proxy forwards to (default http://localhost:3000).
# VITE_PROXY_TARGET=http://localhost:3000
